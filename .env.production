# ==============================================================================
# Old Bear Rodeo - Production Environment Configuration (.env.production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container Images & Registry
# ------------------------------------------------------------------------------
# Private Docker registry prefix (leave empty for local images or docker.io)
IMAGE_REGISTRY=registry.tomusan.com/
IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# 2. Network & Ingress Ports
# ------------------------------------------------------------------------------
# Nginx public HTTP ingress port (typically 80, or a host port behind an external reverse proxy like NPM/Traefik)
NGINX_PORT=80

# Internal client and server service ports
CLIENT_PORT=80
SERVER_PORT=3001

# PostgreSQL database port (only exposed internally or for remote admin)
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=oldbear
POSTGRES_PASSWORD=oldbear_production_secret_password_change_me
POSTGRES_DB=oldbear_vtt
DATABASE_URL=postgres://oldbear:oldbear_production_secret_password_change_me@postgres:5432/oldbear_vtt

# Host path for persistent Postgres data (bind mount or Docker volume)
PGDATA_PATH=/mnt/Data/Apps/oldbear-vtt/pgdata

# ------------------------------------------------------------------------------
# 4. Environment & Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 5. Upload & Storage Limits
# ------------------------------------------------------------------------------
# Maximum asset upload size in Megabytes (maps, tokens, audio tracks)
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 6. Security & CORS
# ------------------------------------------------------------------------------
# Allowed origins for HTTP API requests ('*' or your domain e.g. https://vtt.yourdomain.com)
CORS_ORIGIN=*
# Production session secret key (generate with: openssl rand -hex 32)
SESSION_SECRET=oldbear_production_session_secure_key_change_me

# ------------------------------------------------------------------------------
# 7. WebRTC Voice & P2P Networking (STUN / TURN)
# ------------------------------------------------------------------------------
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
