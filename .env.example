# ==============================================================================
# Old Bear Rodeo - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Service Ports (Bug #46)
# ------------------------------------------------------------------------------
# Vite development client port
CLIENT_PORT=3000

# Backend Node.js / Express & WebSocket signaling server port
SERVER_PORT=3001

# Nginx reverse proxy HTTP ingress port
NGINX_PORT=80

# PostgreSQL database host port
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=oldbear
POSTGRES_PASSWORD=oldbear_secret_password
POSTGRES_DB=oldbear_vtt
DATABASE_URL=postgres://oldbear:oldbear_secret_password@postgres:5432/oldbear_vtt

# ------------------------------------------------------------------------------
# 3. Environment & Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 4. Upload & Storage Limits
# ------------------------------------------------------------------------------
# Maximum file upload size in Megabytes (for maps, tokens, and audio assets)
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 5. Security & CORS
# ------------------------------------------------------------------------------
# Allowed origins for HTTP API requests ('*' for permissive local dev)
CORS_ORIGIN=*
# Secret key used for session authentication / tokens
SESSION_SECRET=oldbear_session_development_secret_change_in_production

# ------------------------------------------------------------------------------
# 6. WebRTC Voice & P2P Networking (STUN / TURN)
# ------------------------------------------------------------------------------
# STUN server (NAT traversal discovery). Public Google STUN server by default.
STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN relay server (Optional, recommended for production when players are behind
# symmetric NATs, mobile carrier networks, or restrictive firewalls).
# Example with coturn: turn:turn.yourdomain.com:3478
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 7. Container Registry & Remote Deployment
# ------------------------------------------------------------------------------
# Registry prefix for building, pushing, and pulling images (e.g., registry.tomusan.com/)
# Leave empty for standard local docker images.
IMAGE_REGISTRY=
IMAGE_TAG=latest

# Persistent host storage path for PostgreSQL (e.g. /mnt/Data/Apps/oldbear-vtt/pgdata)
# Leave empty to use the default named Docker volume ('pgdata').
PGDATA_PATH=

# ------------------------------------------------------------------------------
# 8. UI & Client Settings (Bug #69)
# ------------------------------------------------------------------------------
# Duration in milliseconds for toast notifications and announcement banners (default: 4500)
TOAST_DURATION_MS=4500
VITE_TOAST_DURATION_MS=4500

