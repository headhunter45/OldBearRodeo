FROM node:22-alpine AS builder
WORKDIR /app

ARG APP_VERSION=""
ARG GIT_COMMIT_HASH=""
ENV VITE_APP_VERSION=${APP_VERSION}
ENV VITE_GIT_COMMIT_HASH=${GIT_COMMIT_HASH}

# Copy root workspace and package files
COPY package*.json ./
COPY VERSION* ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/client/package*.json ./packages/client/

RUN npm install

COPY packages/shared ./packages/shared
RUN npm run build -w @oldbear/shared

COPY packages/client ./packages/client
RUN npm run build -w @oldbear/client

FROM nginx:alpine
ARG CLIENT_PORT=80
ENV CLIENT_PORT=${CLIENT_PORT}

COPY --from=builder /app/packages/client/dist /usr/share/nginx/html

RUN printf 'server {\n    listen %s;\n    server_name _;\n    location / {\n        root /usr/share/nginx/html;\n        index index.html index.htm;\n        try_files $uri $uri/ /index.html;\n    }\n}\n' "${CLIENT_PORT}" > /etc/nginx/conf.d/default.conf

EXPOSE ${CLIENT_PORT}

CMD ["/bin/sh", "-c", "printf 'server {\\n    listen %s;\\n    server_name _;\\n    location / {\\n        root /usr/share/nginx/html;\\n        index index.html index.htm;\\n        try_files $uri $uri/ /index.html;\\n    }\\n}\\n' \"${CLIENT_PORT:-80}\" > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]

