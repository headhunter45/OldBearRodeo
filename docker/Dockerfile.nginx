FROM nginx:alpine

# Bake the reverse proxy configuration template directly into the image
COPY docker/nginx.conf /etc/nginx/nginx.conf.template

ENV CLIENT_PORT=80
ENV SERVER_PORT=3001
ENV NGINX_PORT=80

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst '${CLIENT_PORT} ${SERVER_PORT} ${NGINX_PORT}' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && exec nginx -g 'daemon off;'"]

